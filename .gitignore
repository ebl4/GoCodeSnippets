// .gitignore file to ignore unnecessary files and directories for go project
# Binaries for programs and plugins
*.exe
*.dll
*.so
# Test binary, build with `go test -c`
*.test
# Output of the go coverage tool, specifically when used with LiteIDE
*.out
# Dependency directories (remove the comment below if you use vendoring)
# vendor/
# Go workspace file
go.work
# Go module files
go.mod
go.sum
go.work.sum
# IDE specific files
.idea/
.vscode/
# Logs and databases
*.log